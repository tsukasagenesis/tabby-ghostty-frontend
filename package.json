{
  "name": "tabby-ghostty-frontend",
  "version": "0.1.0",
  "description": "Ghostty's VT engine (via ghostty-web/WASM) as an alternative terminal frontend for Tabby",
  "keywords": [
    "tabby-plugin",
    "ghostty",
    "terminal",
    "tabby",
    "wasm"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "prepublishOnly": "npm run build"
  },
  "author": "Theo Bousquet",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "17.3.5",
    "@angular/core": "17.3.5",
    "rxjs": "7.8.1",
    "tabby-core": "1.0.197-nightly.1",
    "tabby-terminal": "1.0.197-nightly.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "ghostty-web": "^0.4.0",
    "tabby-settings": "1.0.197-nightly.1",
    "@angular/forms": "17.3.5"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukasagenesis/tabby-ghostty-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/tsukasagenesis/tabby-ghostty-frontend/issues"
  },
  "homepage": "https://github.com/tsukasagenesis/tabby-ghostty-frontend#readme",
  "engines": {
    "node": ">=18"
  }
